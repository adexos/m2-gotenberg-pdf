<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="adexos" translate="label" sortOrder="10">
            <label>Adexos</label>
        </tab>
        <section id="gotenberg" translate="label" sortOrder="130" showInDefault="1" showInWebsite="1"
                 showInStore="1">
            <class>separator-top</class>
            <label>Gotenberg PDF</label>
            <tab>adexos</tab>
            <resource>Adexos_GotenbergPDF::gotenbergpdf_config</resource>
            <group id="configuration" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>General Configuration</label>
                <field id="endpoint" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Endpoint</label>
                    <validate>required-entry</validate>
                </field>
                <field id="source_base_url" translate="label comment" type="text" sortOrder="5" showInDefault="1"
                       showInWebsite="1" showInStore="1">
                    <label>Source Base URL</label>
                    <comment>Optional. Scheme and host that Gotenberg uses to reach Magento, replacing those of the
                        page URL to convert (path and query are kept). Useful when the public host is protected
                        (SSO, WAF) and an internal host is reachable from Gotenberg. Example:
                        https://magento.internal.example.com. Leave empty to use the URL as is.</comment>
                </field>
                <field id="encryption_key" translate="label" type="obscure" sortOrder="18" showInDefault="1" showInWebsite="1"
                    showInStore="1">
                    <label>Encryption Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                </field>
            </group>
        </section>
    </system>
</config>
