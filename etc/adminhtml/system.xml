<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="adexos" translate="label" sortOrder="10">
            <label>Adexos</label>
        </tab>
        <section id="gotenberg" translate="label" sortOrder="130" showInDefault="1" showInWebsite="1"
                 showInStore="1">
            <class>separator-top</class>
            <label>Gotenberg PDF</label>
            <tab>adexos</tab>
            <resource>Adexos_GotenbergPDF::gotenbergpdf_config</resource>
            <group id="configuration" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>General Configuration</label>
                <field id="endpoint" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1"
                       showInStore="1">
                    <label>Endpoint</label>
                    <validate>required-entry</validate>
                </field>
                <field id="encryption_key" translate="label" type="obscure" sortOrder="18" showInDefault="1" showInWebsite="1"
                    showInStore="1">
                    <label>Encryption Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                </field>
            </group>
        </section>
    </system>
</config>
